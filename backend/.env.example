# Copy this file to backend/.env and replace placeholder values.
# DB_SSLMODE: set to "require" for hosted PostgreSQL that mandates TLS
# (e.g. Neon). Leave unset/empty for the local Docker stack.
# DB_SSLMODE=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=serviceflow
DB_USER=serviceflow
DB_PASSWORD=replace-with-local-database-password

JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GMAIL_SMTP_USER=your-account@example.com
GMAIL_SMTP_APP_PASSWORD=replace-with-gmail-app-password
FRONTEND_VERIFY_EMAIL_URL=http://localhost:5173/verify-email
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Comma-separated CORS origins. Add the deployed frontend origin here
# (e.g. the Cloudflare Pages URL) in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare R2 storage for policy PDFs (optional). When all four values
# are set, policy files are stored in the bucket instead of local disk —
# required on hosts with an ephemeral filesystem (e.g. Render).
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=serviceflow-policies

# Optional for Gemini generation. Set these in the process environment
# when running generation directly.
# GEMINI_API_KEY=
# GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
