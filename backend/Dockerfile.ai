FROM python:3.12-slim

WORKDIR /srv/backend
COPY backend/requirements.txt ./requirements.txt
RUN python -m pip install --timeout 180 --retries 10 torch --index-url https://download.pytorch.org/whl/cpu
RUN python -m pip install --timeout 180 --retries 10 -r requirements.txt "fastmcp>=4.2,<5"

# Copy source only; the local backend/.env must never enter the image.
COPY backend/app/ ./app/
COPY backend/alembic/ ./alembic/
COPY backend/alembic.ini ./alembic.ini

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
